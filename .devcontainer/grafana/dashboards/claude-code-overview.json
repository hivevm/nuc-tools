  "templating": {
    "list": [
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "description": "Claude Code's session.id; one per started or resumed session.",
        "query": {
          "refId": "tempvar",
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT DISTINCT Attributes['session.id'] FROM otel.otel_metrics_sum\nWHERE MetricName LIKE 'claude_code.%' AND $__timeFilter(TimeUnix) ORDER BY 1"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0
      }
    ]
