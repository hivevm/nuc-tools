          "format": 2,
          "queryType": "logs",
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT Timestamp AS timestamp,\n       arrayStringConcat(arrayFilter(x -> x != '', [\n           LogAttributes['event.name'], LogAttributes['tool_name'], LogAttributes['model'],\n           LogAttributes['status_code']]), ' · ') AS body,\n       SeverityText AS level,\n       LogAttributes['session.id'] AS session\nFROM otel.otel_logs\nWHERE ServiceName = 'claude-code' AND $__timeFilter(Timestamp) AND match(LogAttributes['session.id'], '${session:regex}')\nORDER BY Timestamp DESC\nLIMIT 500"
