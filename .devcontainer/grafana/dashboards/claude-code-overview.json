          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.20.0",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time,\n       quantile(0.5)(toFloat64OrZero(LogAttributes['duration_ms'])) AS p50,\n       quantile(0.95)(toFloat64OrZero(LogAttributes['duration_ms'])) AS p95\nFROM otel.otel_logs\nWHERE LogAttributes['event.name'] IN ('api_request', 'claude_code.api_request')\n  AND $__timeFilter(Timestamp) AND match(LogAttributes['session.id'], '${session:regex}')\nGROUP BY time\nORDER BY time"
