#!/bin/sh
#
# Git pre-commit hook, the reference shim of nuc (API-hook-contract-keyed-shims): 'nuc hook
# pre-commit' decides from the git state, and this shim runs the project's full check or its
# documentation check where nuc answers that one runs.
#
# nuc refuses a commit on main, and from template release v0.11.0 the commit that concludes a merge
# on a feat/ branch. It answers 3 on the commit that concludes a conflicted merge on any other
# branch: the shim then runs scripts/check-all.sh --changed. From v0.9.0 it answers 4 on every
# other commit off main: the shim then runs scripts/check-docs.sh. Either runs with the variables
# git hands a hook unset, and the shim refuses while it is red or cannot run. Every answer but 0,
# 3, and 4 refuses, a panic's 101 and a code a later nuc adds included. Without nuc on the PATH it
# refuses and names where to install it.
#
# POSIX sh, so that git for Windows runs it with the sh it bundles. Bypassable with
# 'git commit --no-verify'; NUC-main-only-via-pr §6 says who may.

if ! command -v nuc >/dev/null 2>&1; then
  echo "pre-commit: refused — nuc is not on the PATH, so no hook decides. Install it from https://github.com/hivevm/nuc-tools/releases [shim/pre-commit:missing]" >&2
  exit 1
fi

nuc hook pre-commit "$@"
answer=$?
case "$answer" in
  0) exit 0 ;;
  3 | 4) ;;
  1 | 2) exit 1 ;;
  *)
    echo "pre-commit: refused — nuc hook pre-commit exited $answer, which this shim does not know [shim/pre-commit:unknown]" >&2
    exit 1
    ;;
esac

if ! root="$(git rev-parse --show-toplevel)"; then
  echo "pre-commit: refused — git names no work tree, so the checks cannot run [shim/pre-commit:outside]" >&2
  exit 1
fi

# The checks build fixture repositories of their own; the variables git hands a hook would bind
# every git command in a fixture to this repository.
# shellcheck disable=SC2046 # one variable name per word
unset $(git rev-parse --local-env-vars)

if [ "$answer" = 4 ]; then
  if ! bash "$root/scripts/check-docs.sh"; then
    echo >&2
    echo "pre-commit: refused — the documentation check is red, and the checks pass before a commit (NUC-checks-are-bash §6). It reads the working tree, so fix what it names there, staged or not, then commit again. [hook/commit-docs:red]" >&2
    exit 1
  fi
elif ! bash "$root/scripts/check-all.sh" --changed; then
  echo >&2
  echo "pre-commit: refused — the checks are red on the resolved merge, and they pass before a branch takes up another (NUC-checks-are-bash §6). Fix them on the merged branch: git merge --abort, then merge again. [hook/merge-checks:red]" >&2
  exit 1
fi

exit 0
