# The functions of src/shell/ that may call what functional_core.reads lists, read by
# tests/functional_core.rs. One entry per line: the file under src/shell/, the function, as
# `Type::name` inside an `impl Type` block, and the entries of functional_core.reads it may call,
# separated by spaces. Each function is defined once; a twin under another `cfg` fails the test.

# The root, resolved once, within which every path must resolve.
tree.rs Tree::new canonicalize
# The one test that a path resolves inside the repository.
tree.rs Tree::resolve canonicalize
# Read or list only what they resolved through Tree::resolve first.
tree.rs Tree::read_bytes fs::read
tree.rs Tree::read_adr read_dir
tree.rs Tree::list read_dir
# Resolves the pointers of the skills as `cd -P` does, to compare and show them, never to read.
tree.rs Tree::read_skills canonicalize
