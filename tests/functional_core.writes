# What a function of src/shell/ calls to write, rename, create, or remove a file or directory, read
# by tests/functional_core.rs: only the functions of functional_core.writers may name it. One entry
# per line, matched as functional_core.reads matches, each under `fs::` so that a variable or a
# variant of the same name is none. Opening a file, which may write as well, is the File and
# OpenOptions of functional_core.reads.

# Writing a file.
fs::write
fs::copy

# Renaming, linking, or changing what a path names.
fs::rename
fs::hard_link
fs::symlink
fs::symlink_file
fs::symlink_dir
fs::soft_link
fs::set_permissions
fs::chown
fs::lchown

# Creating a directory.
fs::create_dir
fs::create_dir_all
fs::DirBuilder

# Removing a file or directory.
fs::remove_file
fs::remove_dir
fs::remove_dir_all
